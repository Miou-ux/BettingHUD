[Unit]
Description=BettingHUD Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/bettinghud
Environment=HOME=/home/ubuntu
Environment=BETTINGHUD_ENV=prod
# Ne pas définir BETTINGHUD_HEADLESS ici : ce flag désactive l’UI Streamlit (réservé aux scripts CLI).
Environment=BETTINGHUD_LIVE_DATA_DAEMON=1
Environment=BETTINGHUD_AUTO_SYNC_TOURS=1
ExecStart=/opt/bettinghud/venv/bin/streamlit run app/dashboard.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true
Restart=always
RestartSec=10
# En cas de crash en boucle : nouvelle fenêtre toutes les 5 min (max 20 tentatives).
StartLimitIntervalSec=300
StartLimitBurst=20
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
