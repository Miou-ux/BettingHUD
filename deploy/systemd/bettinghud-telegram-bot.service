[Unit]
Description=BettingHUD Telegram Bot (/jour, /top5, /help)
After=network-online.target bettinghud-dashboard.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/bettinghud
Environment=HOME=/home/ubuntu
Environment=BETTINGHUD_ENV=prod
Environment=PYTHONPATH=/opt/bettinghud
EnvironmentFile=-/opt/bettinghud/.env
ExecStart=/opt/bettinghud/venv/bin/python /opt/bettinghud/scripts/telegram_bot_daemon.py
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=20
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
